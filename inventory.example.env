# Copy to inventory.env and fill IPs. HOSTS=name:ip:listen_port,...
PROFILE=aws-g7e
NIXL_BACKEND=LIBFABRIC
RAIL=efa
CAP_GBS=12.5
CAP_GBPS=100

HUB=node0
HOSTS=node0:10.0.0.10:5550,node1:10.0.0.11:5551,node2:10.0.0.12:5552

NIXL_RV=http://10.0.0.10:8766
NIXL_FILES=http://10.0.0.10:8765
NIXL_RV_BIND=0.0.0.0
NIXL_RV_PORT=8766

FI_PROVIDER=efa
FI_EFA_USE_DEVICE_RDMA=0
FI_EFA_ENABLE_SHM=0
FI_EFA_ENABLE_SHM_TRANSFER=0
RDMAV_FORK_SAFE=1

NIXL_BLOCK_SIZE=16777216
NIXL_BATCH=8
NIXL_ITERS=200
NIXL_WARMUP=50

# AWS EC2 G7e 8xlarge (100 Gbps ENA + 1 EFA). Fill private IPs after launch.
PROFILE=aws-g7e
NIXL_BACKEND=LIBFABRIC
RAIL=efa
CAP_GBS=12.5
CAP_GBPS=100

HUB=node0
HOSTS=node0:REPLACE_IP0:5550,node1:REPLACE_IP1:5551,node2:REPLACE_IP2:5552

NIXL_RV=http://REPLACE_IP0:8766
NIXL_FILES=http://REPLACE_IP0:8765
NIXL_RV_BIND=0.0.0.0
NIXL_RV_PORT=8766

FI_PROVIDER=efa
# GPUDirect RDMA is not available on g7e.8xlarge (single GPU). DRAM WRITE is the target.
FI_EFA_USE_DEVICE_RDMA=0
FI_EFA_ENABLE_SHM=0
FI_EFA_ENABLE_SHM_TRANSFER=0
RDMAV_FORK_SAFE=1

NIXL_BLOCK_SIZE=16777216
NIXL_BATCH=8
NIXL_ITERS=200
NIXL_WARMUP=50
